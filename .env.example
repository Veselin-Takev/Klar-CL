# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SENTRY_DSN: Sentry DSN for error tracking and performance monitoring.
VITE_SENTRY_DSN=""

# ── Lokaler Entwicklungsmodus ──────────────────────────────────────────────
# `npm run dev:lokal` startet Auth- und Firestore-Emulator und den Server in
# einem Zug. Firebase-Zugangsdaten braucht es dafuer nicht.
#
# Der KI-Coach braucht trotzdem einen echten Gemini-Schluessel — dafuer gibt
# es keinen Emulator. Ohne ihn laeuft die App, die KI-Endpunkte antworten mit
# einem Fehler.
#
# GEMINI_MODEL ist optional; ohne Angabe gilt die Vorgabe im Code.
# GEMINI_MODEL="gemini-2.5-flash"
#
# TRUST_PROXY_HOPS: Anzahl vorgeschalteter Proxys (SEC-10). Lokal 0,
# Cloud Run 1, Cloud Run hinter Load Balancer 2. Ein zu hoher Wert macht
# das IP-Limit ueber X-Forwarded-For umgehbar.
TRUST_PROXY_HOPS="0"
