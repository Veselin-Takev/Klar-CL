rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // P0-5: Meldungen entstehen ausschliesslich ueber /api/report
    // (Admin-SDK). Client-seitig vollstaendig gesperrt — auch lesend, damit
    // niemand erfaehrt, wer wen gemeldet hat.
    match /reports/{reportId} {
      allow read, write: if false;
    }
    match /ad_transactions/{txId} {
      allow read, write: if false; // Server only
    }
    // ── DAT-03 ───────────────────────────────────────────────────────────
    // BEFUND: `allow read: if signedIn()`. Damit war der gesamte
    // Sozialgraph fuer jedes angemeldete Konto lesbar — „wer hat wen
    // kontaktiert", ueber alle Nutzer hinweg. Das ist die Grundlage fuer
    // Stalking und fuer das Outing von Beziehungen, die niemanden etwas
    // angehen. Eine Dating-App darf das nicht preisgeben.
    //
    // Die Feldnamen sind im Bestand uneinheitlich (fromUid/toUid,
    // senderId/receiverId, userId/otherUserId — siehe die Kaskade in
    // trustAndSafety.ts). `data.get(feld, '')` liest ein fehlendes Feld
    // als leeren Text, statt die Regel mit einem Fehler abzubrechen;
    // ein direkter Zugriff auf ein nicht vorhandenes Feld wuerde die
    // ganze Bedingung scheitern lassen.
    match /connections/{connId} {
      allow read: if signedIn() && (
           request.auth.uid == resource.data.get('fromUid', '')
        || request.auth.uid == resource.data.get('toUid', '')
        || request.auth.uid == resource.data.get('senderId', '')
        || request.auth.uid == resource.data.get('receiverId', '')
        || request.auth.uid == resource.data.get('userId', '')
        || request.auth.uid == resource.data.get('otherUserId', '')
      );
      allow write: if false; // Server only handled via QuotaLedgerService
    }

    // P0-4: Diese Funktion hiess isVerified(), prueft aber nur, ob jemand
    // angemeldet ist. Der Name behauptete eine Pruefung, die nicht
    // stattfand — und weil er ueberall stand, sah jede Regel geprueft aus.
    // Jetzt heisst sie, was sie tut.
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Die ECHTE Verifizierung. Nur der Server setzt isVerified (Sichtpruefung
    // des Verifizierungsfotos); der Client kann das Feld nicht schreiben —
    // siehe keepsServerFields() unten.
    function isVerified(uid) {
      return signedIn() && userDoc(uid).isVerified == true;
    }

    function blocked(otherUid) {
      return exists(/databases/$(database)/documents/blocks/$(otherUid + '_' + request.auth.uid))
          || exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + otherUid));
    }

    // Felder, die ausschliesslich der Server setzen darf. Ohne diese Liste
    // vergibt sich jedes Konto Verifizierung, Abo und Rollen selbst.
    function keepsServerFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isVerified', 'trustScore', 'plan', 'roles',
                 'contactDay', 'contactCount', 'quotaLedger',
                 'verificationStatus', 'verificationGeste',
                 // DSG-02: Alter und Einwilligung gehoeren dem Server.
                 // Vorher stand `isAdult: true` fest verdrahtet im Client —
                 // die App behauptete die Volljaehrigkeit ueber sich selbst.
                 // Waere das Feld hier nicht gesperrt, koennte der Client es
                 // weiterhin selbst setzen und die Pruefung waere Zierde.
                 'isAdult', 'geburtsdatum', 'alterGeprueftAm', 'einwilligung']);
    }

    // Validation for User entity
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt']) 
             && data.uid is string
             && data.createdAt is string
             && data.updatedAt is string
             && (!('name' in data) || data.name is string)
             && (!('bio' in data) || data.bio is string)
             && (!('interests' in data) || data.interests is list)
             && (!('goal' in data) || data.goal is string)
             && (!('isAdult' in data) || data.isAdult is bool)
             && (!('smartMatchAlerts' in data) || data.smartMatchAlerts is bool);
    }
    
    // Validation for User Update
    function isValidUserUpdate(data, prevData) {
      // ── DAT-07 ─────────────────────────────────────────────────────────
      // BEFUND: Hier stand `hasAny(...)`. Das bedeutet „mindestens EINES
      // dieser Felder aendert sich" — und laesst damit jedes andere Feld
      // mitlaufen, solange nur eines aus der Liste dabei ist. Gemeint war
      // das Gegenteil.
      //
      // Zweite Haelfte desselben Befunds: `theme` und `moodHistory` standen
      // in KEINER Liste. `ThemeProvider.tsx:77` und `MoodDiaryWidget.tsx:73`
      // schreiben genau diese Felder — beide Schreibvorgaenge wurden von den
      // Regeln abgelehnt. Im Entwicklungsbetrieb faellt das nicht auf, weil
      // `updateProfileData` den Fehler nur in die Konsole schreibt und die
      // Oberflaeche trotzdem den neuen Wert zeigt.
      //
      // `hasOnly` sagt, was gemeint war: NUR diese Felder. Damit ist
      // keepsServerFields() unten streng genommen doppelt — die Liste bleibt
      // trotzdem stehen. Zwei unabhaengige Sperren fuer `isVerified` sind
      // die richtige Menge, nachdem eine davon schon einmal versagt hat.
      return data.diff(prevData).affectedKeys()
               .hasOnly(['name', 'bio', 'interests', 'goal', 'smartMatchAlerts',
                         'updatedAt', 'theme', 'moodHistory', 'userSettings',
                         'photoUrl', 'location', 'age'])
             && (!('name' in data) || data.name is string)
             && (!('bio' in data) || data.bio is string)
             && (!('interests' in data) || data.interests is list)
             && (!('goal' in data) || data.goal is string)
             && (!('isAdult' in data) || data.isAdult is bool)
             && (!('smartMatchAlerts' in data) || data.smartMatchAlerts is bool)
             && data.updatedAt is string
             && data.uid == prevData.uid
             && data.createdAt == prevData.createdAt;
    }

    
    // Quota ledger for daily contacts
    match /users/{userId}/quota_ledger/{docId} {
      // Only the server (Admin SDK) can write to the ledger
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false; 
    }

    // ── DAT-02 ───────────────────────────────────────────────────────────
    // BEFUND (Final Audit 08.08.2026): `allow read: if signedIn()` auf dem
    // GANZEN Profildokument. Jedes angemeldete Konto konnte jedes andere
    // Profil vollstaendig lesen — einschliesslich `moodHistory`, also
    // Stimmungsaufzeichnungen. Das sind Daten ueber die psychische
    // Gesundheit und damit besondere Kategorien nach Art. 9 DSGVO. Dazu
    // `plan`, `trustScore`, `geburtsdatum`, `einwilligung`. Ueber
    // UID-Enumeration war der gesamte Bestand abgreifbar.
    //
    // NACHGESEHEN, BEVOR ICH ES GEAENDERT HABE: Kein einziger Lesezugriff
    // im Client betrifft ein FREMDES Profil. Jede Fundstelle von
    // `doc(db,'users',…)` benutzt die eigene uid. Die Vorschlaege im
    // Dashboard kommen aus `src/data.ts` — vier erfundene Profile (FUN-01).
    // Der bisherige Kommentar hier („sonst gaebe es keine Vorschlaege")
    // beschrieb also eine Notwendigkeit, die es nicht gab. Meine eigene
    // Regelprobe hat diese Annahme uebernommen und festgeschrieben.
    //
    // Das Profil ist damit ab jetzt eine private Ablage. Oeffentlich
    // sichtbare Felder gehoeren in `public_profiles` (unten) — eine
    // Trennung, die es geben muss, BEVOR K-2 echte Vorschlaege baut.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
                    && isValidUser(request.resource.data)
                    && !request.resource.data.keys().hasAny(['isVerified', 'trustScore', 'plan', 'roles',
                                                             'isAdult', 'geburtsdatum', 'alterGeprueftAm',
                                                             'einwilligung']);
      // P0-4: keepsServerFields() ist der eigentliche Schutz. Ohne ihn
      // konnte sich jedes Konto isVerified: true selbst setzen — und damit
      // jede Regel aushebeln, die auf Verifizierung prueft.
      allow update: if signedIn() && request.auth.uid == userId
                    && isValidUserUpdate(request.resource.data, resource.data)
                    && keepsServerFields();
      // Loeschung laeuft ueber /api/account/delete (Kaskade, Art. 17 DSGVO).
      allow delete: if false;
    }

    // ── Oeffentliches Profil ─────────────────────────────────────────────
    // Die Gegenstelle zu DAT-02: Was andere sehen duerfen, steht hier —
    // und NUR das. Name, Alter, Ort, Bio, Interessen, Foto,
    // Verifizierungszeichen. Keine Stimmungen, kein Plan, kein
    // Geburtsdatum, keine Einwilligung.
    //
    // HEUTE SCHREIBT NIEMAND HIERHER. Die Sammlung ist leer, und das ist
    // kein Versehen: Die Vorschlaege sind noch erfunden (FUN-01), es gibt
    // also nichts zu spiegeln. Die Regel steht trotzdem schon da, damit
    // K-2 nicht wieder `users` oeffnet, wenn echte Vorschlaege kommen —
    // der bequeme Weg soll dann der richtige sein.
    //
    // Geschrieben werden darf nur vom Server (Admin-SDK), damit der
    // Spiegel nicht vom Client gefaelscht werden kann.
    match /public_profiles/{userId} {
      allow read: if signedIn() && !blocked(userId);
      allow write: if false;
    }

    // Blockierungen. Gerichteter Eintrag, beidseitige Wirkung ueber blocked().
    match /blocks/{blockId} {
      allow get, list: if signedIn() && request.auth.uid == resource.data.blockerUid;
      allow create: if signedIn()
                    && request.resource.data.blockerUid == request.auth.uid
                    && blockId == request.auth.uid + '_' + request.resource.data.blockedUid;
      allow delete: if signedIn() && request.auth.uid == resource.data.blockerUid;
      allow update: if false;
    }

    // Validation for Chat entity
    function isValidChat(data) {
      return data.keys().hasAll(['participants', 'createdAt'])
             && data.participants is list
             && data.participants.size() == 2
             && data.createdAt is string
             && (!('lastMessage' in data) || data.lastMessage is string)
             && (!('lastMessageAt' in data) || data.lastMessageAt is string);
    }

    function isValidChatUpdate(data, prevData) {
      return data.diff(prevData).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
             && data.lastMessage is string
             && data.lastMessageAt is string
             && data.participants == prevData.participants
             && data.createdAt == prevData.createdAt;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      // Ein Chat entsteht durch den ersten Kontakt — dafuer ist die
      // Verifizierung Voraussetzung (Konzept: nur verifizierte Menschen
      // erscheinen und handeln).
      allow create: if isVerified(request.auth.uid)
                    && request.auth.uid in request.resource.data.participants
                    && isValidChat(request.resource.data);
      allow update: if signedIn() && request.auth.uid in resource.data.participants && isValidChatUpdate(request.resource.data, resource.data);
      // Ein Chat gehoert beiden. Einseitiges Loeschen wuerde der anderen
      // Person den Verlauf nehmen — und jede Meldung nach DSA Art. 16
      // wertlos machen.
      allow delete: if false;

      // Validation for Message entity
      function isValidMessage(data, parentData) {
        return data.keys().hasAll(['chatId', 'senderId', 'text', 'createdAt'])
               && data.chatId == chatId
               && data.senderId == request.auth.uid
               && data.text is string
               && data.text.size() <= 1000
               && data.createdAt is string;
      }

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn() 
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants 
                      && isValidMessage(request.resource.data, get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow update: if false; // Messages should be immutable
        allow delete: if false;
      }
    }
    // ── Kontingent: der Zaehler gehoert dem Server ───────────────────────
    // Ein Kontakt ist die ERSTE Nachricht an einen neuen Menschen. Die
    // Dokument-ID ist "<von>_<an>" — ein zweiter Kontakt an dieselbe Person
    // ist damit technisch unmoeglich, ohne dass eine Abfrage noetig waere.
    match /contacts/{contactId} {
      allow get, list: if signedIn()
                       && (request.auth.uid == resource.data.fromUid
                        || request.auth.uid == resource.data.toUid);
      // Nur der Server schreibt (Transaktion in /api/contact). Client-seitig
      // gesperrt: Sonst legt jemand Kontakte an, ohne dass gezaehlt wird.
      allow write: if false;
    }

    // ── DSG-02: Einwilligung und Alter ───────────────────────────────────
    // Der Nachweis nach Art. 7 Abs. 1 DSGVO muss unveraenderlich sein. Waere
    // er clientseitig schreibbar, koennte er nachtraeglich passend gemacht
    // werden — und damit waere er kein Nachweis. Gelesen wird ueber
    // GET /api/einwilligung, geschrieben nur vom Server.
    match /users/{userId}/einwilligungen/{id} {
      allow read, write: if false;
    }

    // ── Zwischenspeicher fuer KI-Auswertungen (11.08.2026) ───────────────
    // Faellt die KI aus, liefern elf Endpunkte die letzte gueltige
    // Auswertung MIT ausgewiesenem Alter (kiPolitik.ts, Strategie
    // `zwischenspeicher`). Hier liegt sie.
    //
    // Nur der Server. Ausdruecklich gesperrt, obwohl schon die Vorgabe
    // „alles gesperrt" gelten wuerde: Der Eintrag zeigt, dass die Sperre
    // eine Entscheidung ist und kein Vergessen. Ein Regeltest bewacht sie.
    //
    // Warum nicht clientseitig lesbar: Der Inhalt ist eine Auswertung UEBER
    // die Person. Waere er direkt lesbar, umginge man damit die Regel, dass
    // solche Auswertungen nur mit ausgewiesener Herkunft und ausgewiesenem
    // Alter ausgeliefert werden — genau das setzt der Server beim Antworten.
    //
    // Speicherfrist 36 Stunden, Aufraeumen beim Lesen: zwischenspeicher.ts
    // Auskunft nach Art. 15: datenschutz.ts
    // Loeschung nach Art. 17: trustAndSafety.ts
    match /users/{userId}/ki_zwischenspeicher/{id} {
      allow read, write: if false;
    }
    // Fehlversuche bei der Altersangabe. Fuer die Moderation, nicht fuer
    // die betroffene Person sichtbar — sonst waere ablesbar, welche Eingabe
    // durchgeht.
    match /age_attempts/{id} { allow read, write: if false; }

    // ── Verifizierung ────────────────────────────────────────────────────
    match /verification_requests/{id} { allow read, write: if false; }
    match /verification_events/{id}   { allow read, write: if false; }

    // ── Abo, Rechtsvorgaenge, Warteschlangen ─────────────────────────────
    match /subscriptions/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;   // nur Server (Kuendigung/Widerruf/Zahlung)
    }
    match /subscription_events/{id} { allow read, write: if false; }
    match /refund_queue/{id}        { allow read, write: if false; }
    match /mail_queue/{id}          { allow read, write: if false; }
    match /deletion_log/{id}        { allow read, write: if false; }

    // Kein Sammel-Match. Was hier nicht steht, ist gesperrt.
  }
}

// P0-2: In dieser Datei stand vor Zeile 57 die Zeichenfolge Backslash-n
// (als Text, nicht als Umbruch) statt eines echten
// Zeilenumbruchs. Die Regeln waren damit nicht parsebar — `firebase deploy`
// haette sie abgelehnt, und bis dahin galten die zuletzt ausgerollten.
